FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb xauth libnss3 libatk-bridge2.0-0 libdrm2 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 \
    libasound2 libcups2 libgtk-3-0 fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
ENV MARDAR_APP_PATH=/workspace/release/linux-unpacked/mardar
CMD ["xvfb-run", "--auto-servernum", "node", "node_modules/@playwright/test/cli.js", "test"]
